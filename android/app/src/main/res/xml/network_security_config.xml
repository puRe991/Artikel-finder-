<?xml version="1.0" encoding="utf-8"?>
<!--
  Die API läuft im Heimnetz über HTTP, die Adresse stellt der Nutzer in der App ein.
  Welche das ist, steht zur Bauzeit nicht fest — deshalb ist Klartext hier generell
  erlaubt statt für eine Liste von Adressen.

  Ein früherer Versuch, das über <domain>192.168.178.0</domain> einzugrenzen, war
  wirkungslos: domain-config vergleicht Hostnamen, nicht Subnetze. Er hätte nur exakt den
  Host "192.168.178.0" erlaubt und jede echte Geräteadresse blockiert.

  Vor einer Veröffentlichung (Phase 3) gehört hier ein HTTPS-Endpunkt hin und diese
  Freigabe raus.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
